---

import PortfolioPicture from "@/components/PortfolioPicture.astro";
import type { Section } from "@/resources/detail-kind";

type Props = Section;

const { label, images, videos } = Astro.props;
---

{label ? <h2 class="mt-10">{label}</h2> : <div class="mt-10" />}

{
  videos ? (
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
      {videos.map(({ alt, poster, webm, mp4 }) => (
        <video
          class="aspect-video h-auto w-full"
          aria-label={alt}
          poster={poster}
          controls
          preload="metadata"
        >
          <source src={webm} type="video/webm" />
          <source src={mp4} type="video/mp4" />
          <p>
            Your browser doesn't support HTML5 video. Here is a{" "}
            <a href={mp4}>link to the video</a>. Description
            for the video: {alt}
          </p>
        </video>
      ))}
    </div>
  ) : null
}

{
  images ? (
    <div class="flex flex-col gap-4 sm:gap-10">
      {images.map(({ src, alt }) => (
        <PortfolioPicture
          src={src}
          alt={alt}
          role="section"
        />
      ))}
    </div>
  ) : null
}
