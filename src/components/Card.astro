---

import PortfolioPicture from "@/components/PortfolioPicture.astro";

import type { DetailCard } from "@/resources/detail-kind";

type Props = DetailCard & { priority?: boolean };

const { label, href, picture, ariaLabel, priority } = Astro.props;
---

<li role="article">
  <div class="order-1">
    <h3>
      <a href={href} aria-label={ariaLabel}>{label}</a>
    </h3>
  </div>
  <div class="overflow-hidden rounded-3xl">
    <PortfolioPicture
      src={picture}
      alt={label}
      role="card"
      priority={priority}
    />
  </div>
</li>

<style>
  @reference "@/styles/global.css";

  li {
    @apply focus-within:border-muted-foreground relative flex flex-col rounded-lg border border-transparent p-1 transition duration-300 ease-in-out motion-safe:hover:scale-[1.03];
  }

  h3 > a {
    @apply after:absolute after:inset-0 hover:no-underline focus:outline-none;
  }
</style>
