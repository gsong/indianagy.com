---
import { FileText, Mail, Phone } from "lucide-react";
import { CDN_RESOURCES } from "../lib/r2";
---

<footer class="bg-secondary mt-6 py-2">
  <div class="site-width my-4 space-y-4">
    <a
      href="mailto:hello@indianagy.com"
      class="flex w-fit items-center gap-2"
      rel="nofollow"
    >
      <Mail size="18" aria-hidden="true" />
      <div>hello@indianagy.com</div>
    </a>

    <a
      href="tel:+12063835468"
      aria-label="Call India at 206-383-5468"
      class="flex w-fit items-center gap-2"
      rel="nofollow"
    >
      <Phone size="18" aria-hidden="true" />
      <div>(206) 383-5468</div>
    </a>

    <a
      href={CDN_RESOURCES.RESUME_PDF}
      aria-label="Download India Nagy's resume (PDF)"
      target="_blank"
      class="flex w-fit items-center gap-2"
      rel="noopener noreferrer"
      data-resume-link
    >
      <FileText size="18" aria-hidden="true" />
      Download my resume
    </a>

    <p class="text-muted-foreground text-sm">
      © <span id="current-year"></span> India Nagy. All rights reserved.
    </p>
  </div>
</footer>

<script>
  function initFooter() {
    document.getElementById("current-year")!.textContent = new Date()
      .getFullYear()
      .toString();

    const link = document.querySelector<HTMLAnchorElement>(
      "[data-resume-link]",
    );
    link?.addEventListener("click", () => {
      const gtag = (window as { gtag?: (...args: unknown[]) => void }).gtag;
      if (gtag) {
        gtag("event", "file_download", {
          file_name: "resume.pdf",
          file_extension: "pdf",
          link_url: link.href,
          link_text: "Download my resume",
        });
      }
    });
  }

  document.addEventListener("astro:page-load", initFooter);
</script>
